mncs 0.7;

// scratchtrack.pack.v1 — exact integer ZIP-store layout kernels.
//
// Machine-native representation of ScratchTrack's uncompressed project-pack
// layout (local headers, central directory, end-of-central-directory).
// Fixed-field offsets, sizes, signatures, and entry-walk arithmetic live
// here; byte access stays host-side. Iteration over dynamic structures
// (backward EOCD scan, per-entry directory walk) stays host-side too:
// dynamic-trip-count and nested iteration are not expressible yet — see
// docs/mncs-pressure.md P-009/P-012. Integrity checksums moved to the
// MNCS CRC model (`mncs/crc.mncs`), which the pack writer delegates to
// through `src/mncsCrc.ts`.
//
// Windows are fixed: local headers parse from `[byte; 46]` (only the
// first 30 bytes are read), central entries from `[byte; 46]`, EOCD from
// `[byte; 22]`. Offset/size accumulation uses u64; field reads keep
// wire types (u16/u32) with `as` conversions at construction.
//
// Signatures (little-endian u32): local 0x04034B50 = 67324752, central
// 0x02014B50 = 33639248, EOCD 0x06054B50 = 101010256.
module scratchtrack.pack.v1;

record Entry {
    name_len: u64,
    extra_len: u64,
    comment_len: u64,
    local_offset: u64,
    data_size: u64,
    crc: u32
}

// ---- Little-endian field readers (fixed windows) ----

fn le16_46(window: [byte; 46], offset: u64) -> (result: u16) {
    let lo: u64 = window[offset] as u64;
    let hi: u64 = window[offset + 1] as u64;
    return (lo +% hi *% 256) as u16;
}

fn le32_46(window: [byte; 46], offset: u64) -> (result: u32) {
    let b0: u64 = window[offset] as u64;
    let b1: u64 = window[offset + 1] as u64;
    let b2: u64 = window[offset + 2] as u64;
    let b3: u64 = window[offset + 3] as u64;
    return (b0 +% b1 *% 256 +% b2 *% 65536 +% b3 *% 16777216) as u32;
}

fn le16_22(window: [byte; 22], offset: u64) -> (result: u16) {
    let lo: u64 = window[offset] as u64;
    let hi: u64 = window[offset + 1] as u64;
    return (lo +% hi *% 256) as u16;
}

fn le32_22(window: [byte; 22], offset: u64) -> (result: u32) {
    let b0: u64 = window[offset] as u64;
    let b1: u64 = window[offset + 1] as u64;
    let b2: u64 = window[offset + 2] as u64;
    let b3: u64 = window[offset + 3] as u64;
    return (b0 +% b1 *% 256 +% b2 *% 65536 +% b3 *% 16777216) as u32;
}

// ---- Local file header (offsets within the 30-byte header) ----

fn local_signature_ok(window: [byte; 46]) -> (result: bool) {
    return le32_46(window, 0) == (67324752 as u32);
}

fn local_name_len(window: [byte; 46]) -> (result: u16) {
    return le16_46(window, 26);
}

fn local_extra_len(window: [byte; 46]) -> (result: u16) {
    return le16_46(window, 28);
}

fn local_data_size(window: [byte; 46]) -> (result: u32) {
    return le32_46(window, 22);
}

// Data start for an entry: header (30) plus variable name/extra runs.
fn local_data_start(local_offset: u64, name_len: u64, extra_len: u64) -> (result: u64) {
    return local_offset +% (30 as u64) +% name_len +% extra_len;
}

// Full local record size for the write path: header + name + data.
fn local_record_size(name_len: u64, data_len: u64) -> (result: u64) {
    return (30 as u64) +% name_len +% data_len;
}

// ---- Central directory entry (46-byte header) ----

fn central_signature_ok(window: [byte; 46]) -> (result: bool) {
    return le32_46(window, 0) == (33639248 as u32);
}

// Structured parse of one central entry: lengths, local header position,
// data size, and checksum in one total function.
fn central_entry(window: [byte; 46]) -> (result: Entry) {
    return Entry {
        name_len: le16_46(window, 28) as u64,
        extra_len: le16_46(window, 30) as u64,
        comment_len: le16_46(window, 32) as u64,
        local_offset: le32_46(window, 42) as u64,
        data_size: le32_46(window, 24) as u64,
        crc: le32_46(window, 16),
    };
}

// Next central entry position: header (46) plus variable runs.
fn central_next(central: u64, name_len: u64, extra_len: u64, comment_len: u64) -> (result: u64) {
    return central +% (46 as u64) +% name_len +% extra_len +% comment_len;
}

// Central record size for the write path: header + name.
fn central_record_size(name_len: u64) -> (result: u64) {
    return (46 as u64) +% name_len;
}

// ---- End of central directory (22-byte record) ----

fn eocd_signature_ok(window: [byte; 22]) -> (result: bool) {
    return le32_22(window, 0) == (101010256 as u32);
}

fn eocd_count(window: [byte; 22]) -> (result: u16) {
    return le16_22(window, 10);
}

fn eocd_central_size(window: [byte; 22]) -> (result: u32) {
    return le32_22(window, 12);
}

fn eocd_central_offset(window: [byte; 22]) -> (result: u32) {
    return le32_22(window, 16);
}

// Fixed EOCD record size for the write path.
fn eocd_size() -> (result: u64) {
    return 22;
}
